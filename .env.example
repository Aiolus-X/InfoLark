# A separate InfoLark Feishu app; do not reuse PaperLark's app credentials.
INFOLARK_FEISHU_APP_ID=
INFOLARK_FEISHU_APP_SECRET=
INFOLARK_PARENT_URL=https://example.feishu.cn/wiki/YourParentToken
# Prefer sending /start in the new InfoLark bot chat to bind this app's open_id.
INFOLARK_RECIPIENT_OPEN_ID=

INFOLARK_TIMEZONE=Asia/Shanghai
INFOLARK_PREPARE_TIME=10:30
INFOLARK_DELIVERY_TIME=11:00
INFOLARK_POLL_MINUTES=30
INFOLARK_DISCOVERY_MINUTES=180
INFOLARK_PORT=8791
INFOLARK_DATA_DIR=data
INFOLARK_MAX_FEATURED=15
INFOLARK_MAX_PER_TIER=5
INFOLARK_MAX_EVIDENCE=50

# Reuse only the local model configuration, not the Feishu identity.
INFOLARK_MODEL_SOURCE=paperlark
PAPERLARK_DIR=../PaperLark
INFOLARK_LLM_BASE_URL=
INFOLARK_LLM_API_KEY=
INFOLARK_LLM_MODEL=
INFOLARK_LLM_API=responses
INFOLARK_LLM_REASONING_EFFORT=xhigh
INFOLARK_LLM_TIMEOUT_MS=600000

# Optional broad-search / direct X access; public discovery still works without these.
BRAVE_SEARCH_API_KEY=
X_BEARER_TOKEN=
INFOLARK_PAPERLARK_BRIDGE=true
